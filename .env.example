# Copy to .env to override the local development defaults in compose.yaml.
# JUPITER_POSTGRES_PASSWORD=jupiter
# JUPITER_POSTGRES_PORT=55432
# JUPITER_OTLP_GRPC_PORT=54317
# JUPITER_OTLP_HTTP_PORT=54318
# JUPITER_JAEGER_UI_PORT=56686
# JUPITER_PROMETHEUS_PORT=59090
# JUPITER_GRAFANA_PORT=53000
# JUPITER_VAULT_POSTGRES_PASSWORD=vault
# JUPITER_VAULT_POSTGRES_PORT=55433

# Read by the api and worker binaries (not by compose). Generate one with:
#   openssl rand -base64 32
# JUPITER_SECRET_KEY=
# JUPITER_DATABASE_URL=postgres://jupiter:jupiter@127.0.0.1:55432/jupiter?sslmode=disable
# Lets the worker deliver webhooks to receivers on this machine. Never set it elsewhere.
# JUPITER_WEBHOOK_ALLOW_PRIVATE=true
# How the api and worker reach the vault; the certificates come from make certs. The
# worker presents its own: .certs/worker.pem and .certs/worker-key.pem.
# JUPITER_VAULT_URL=https://localhost:8082
# JUPITER_VAULT_CA=.certs/ca.pem
# JUPITER_VAULT_CLIENT_CERT=.certs/api.pem
# JUPITER_VAULT_CLIENT_KEY=.certs/api-key.pem

# How the api and worker reach the card network (sim-card-network); without it, live mode
# has no rail.
# JUPITER_CARDNET_ADDR=127.0.0.1:8583
# JUPITER_CARDNET_URL=http://127.0.0.1:8584
# The secret the network signs token events with (sim-card-network's JUPITER_CARDNET_EVENTS_SECRET).
# JUPITER_CARDNET_EVENTS_SECRET=
# JUPITER_ACQUIRER_ID=10000000001
# The link carries card numbers in plain TCP: only to this machine, unless this says it
# is a private circuit.
# JUPITER_CARDNET_PRIVATE_LINK=false

# 3-D Secure: the directory server (sim-3ds), Jupiter's address as browsers and the
# directory server reach it, and the secret the directory server signs results with.
# JUPITER_3DS_DIRECTORY_URL=http://127.0.0.1:8585/ds/areq
# JUPITER_PUBLIC_URL=http://127.0.0.1:8080
# JUPITER_3DS_RESULTS_SECRET=
# Customers are sent only to an issuer's ACS over HTTPS; true accepts the simulator's http.
# JUPITER_3DS_ALLOW_HTTP=true

# Pix: Jupiter's bank (sim-pix), with the certificates from make certs. Live mode reads
# JUPITER_PIX_*, test mode JUPITER_PIX_TEST_* (the bank's sandbox); a mode without a URL
# has no Pix. The bank notifies WEBHOOK_URL/pix, which the api serves on
# JUPITER_PIX_WEBHOOK_ADDR over mutual TLS, admitting only the bank's certificate.
# JUPITER_PIX_URL=https://127.0.0.1:8586
# JUPITER_PIX_CLIENT_ID=jupiter-live
# JUPITER_PIX_CLIENT_SECRET=
# JUPITER_PIX_KEY=7f6e5d4c-3b2a-4190-8f7e-6d5c4b3a2918
# Jupiter's account at the bank, which Pix Automático (with no keys) is paid to.
# JUPITER_PIX_ACCOUNT=jupiter-live
# JUPITER_PIX_BRANCH=0001
# JUPITER_PIX_CERT=.certs/pix-client.pem
# JUPITER_PIX_CERT_KEY=.certs/pix-client-key.pem
# JUPITER_PIX_CA=.certs/ca.pem
# JUPITER_PIX_WEBHOOK_URL=https://127.0.0.1:8443/pix/live
# JUPITER_PIX_TEST_URL=https://127.0.0.1:8586
# JUPITER_PIX_TEST_CLIENT_ID=jupiter-test
# JUPITER_PIX_TEST_CLIENT_SECRET=
# JUPITER_PIX_TEST_KEY=0d9c3f4e-3a2b-4c1d-9e8f-7a6b5c4d3e2f
# JUPITER_PIX_TEST_ACCOUNT=jupiter-test
# JUPITER_PIX_TEST_CERT=.certs/pix-client.pem
# JUPITER_PIX_TEST_CERT_KEY=.certs/pix-client-key.pem
# JUPITER_PIX_TEST_CA=.certs/ca.pem
# JUPITER_PIX_TEST_WEBHOOK_URL=https://127.0.0.1:8443/pix/test
# JUPITER_PIX_WEBHOOK_ADDR=127.0.0.1:8443
# JUPITER_PIX_WEBHOOK_CERT=.certs/pix-webhooks.pem
# JUPITER_PIX_WEBHOOK_KEY=.certs/pix-webhooks-key.pem
# JUPITER_PIX_WEBHOOK_CA=.certs/ca.pem
# JUPITER_PIX_WEBHOOK_IDENTITY=spiffe://sim-pix/webhook

# The receivables registry (sim-registry), where Jupiter registers card receivables as a
# sub-acquirer. Live mode reads JUPITER_REGISTRY_*, test mode JUPITER_REGISTRY_TEST_*; a
# mode without a URL keeps its receivables without registering them. The modes need
# registries of their own: a merchant's units in both would share their keys. ISPB and
# BRANCH name Jupiter's account, where merchants' units settle.
# FINANCIER_TOKEN is Jupiter's as the financier of the units it anticipates; JUPITER_TAX_ID
# is Jupiter's CNPJ, the beneficiary of those contracts.
# JUPITER_TAX_ID=11222333000181
# JUPITER_REGISTRY_URL=http://127.0.0.1:8588
# JUPITER_REGISTRY_TOKEN=
# JUPITER_REGISTRY_FINANCIER_TOKEN=
# JUPITER_REGISTRY_TEST_URL=http://127.0.0.1:8589
# JUPITER_REGISTRY_TEST_TOKEN=
# JUPITER_REGISTRY_TEST_FINANCIER_TOKEN=
# JUPITER_REGISTRY_ISPB=30000001
# JUPITER_REGISTRY_BRANCH=0001

# Read by the simulators: the key sim-3ds makes authentication values with and
# sim-card-network checks them with, and where the network sends token events.
# JUPITER_SIM_AUTHENTICATION_KEY=
# JUPITER_CARDNET_EVENTS_URL=http://127.0.0.1:8080/network/v1/token-events
# sim-pix: its certificates, and its clients as id:secret:key:balance (in reais).
# JUPITER_SIM_TLS_CERT=.certs/sim-pix.pem
# JUPITER_SIM_TLS_KEY=.certs/sim-pix-key.pem
# JUPITER_SIM_TLS_CA=.certs/ca.pem
# JUPITER_SIM_WEBHOOK_CERT=.certs/sim-pix-hook.pem
# JUPITER_SIM_WEBHOOK_KEY=.certs/sim-pix-hook-key.pem
# JUPITER_SIM_PIX_CLIENTS=jupiter-live:<secret>:7f6e5d4c-3b2a-4190-8f7e-6d5c4b3a2918:1000000,jupiter-test:<secret>:0d9c3f4e-3a2b-4c1d-9e8f-7a6b5c4d3e2f:1000000
# sim-registry: who may use it, as token:cnpj:role (accreditor or financier).
# JUPITER_SIM_REGISTRY_PARTICIPANTS=<token>:11222333000181:accreditor,<token>:11222333000181:financier,<token>:33000167000101:financier

# Read by the vault binary. Keys are 32 random bytes in base64 (openssl rand -base64 32).
# JUPITER_DATABASE_URL=postgres://vault:vault@127.0.0.1:55433/vault?sslmode=disable
# JUPITER_VAULT_KEKS=2026-09:<key>
# JUPITER_VAULT_ACTIVE_KEK=2026-09
# JUPITER_VAULT_FINGERPRINT_KEY=<key>
# JUPITER_VAULT_TLS_CERT=.certs/vault.pem
# JUPITER_VAULT_TLS_KEY=.certs/vault-key.pem
# JUPITER_VAULT_CLIENT_CA=.certs/ca.pem
